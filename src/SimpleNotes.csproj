<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SimpleNotes</AssemblyName>
    <RootNamespace>SimpleNotes</RootNamespace>
    <ApplicationTitle>Simple Notes</ApplicationTitle>
    <!-- Icon shown on the .exe in Explorer, on shortcuts, and the taskbar -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Bump this for each release; the tag you push (vX.Y.Z) should match. -->
    <Version>1.0.0</Version>
    <Company>mdoulos</Company>
    <Product>Simple Notes</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same icon, embedded as a resource so the running window can use it too -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
