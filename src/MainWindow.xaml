<Window x:Class="PurpleStarNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PurpleStarNotes"
        Title="Purple Star Notes"
        Icon="app.ico"
        Height="640" Width="1120"
        MinHeight="440" MinWidth="820"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="260"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT SIDEBAR                                                  -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: "Notes" + sort + add -->
                <Grid Grid.Row="0" Margin="18,16,14,6">
                    <TextBlock Text="Notes"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SortButton" Style="{StaticResource IconButton}"
                                Content="&#xE8CB;" ToolTip="Sort by date modified"
                                Click="SortButton_Click"/>
                        <Button x:Name="AddButton" Style="{StaticResource AccentButton}"
                                Content="&#xE710;" Margin="6,0,0,0" ToolTip="New note"
                                Click="AddButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Search box -->
                <Border Grid.Row="1" Margin="14,8,14,10"
                        Background="{DynamicResource FieldBrush}"
                        CornerRadius="10" Padding="12,0">
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="Search..."
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Notes list -->
                <ListBox x:Name="NotesList" Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NoteItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="NotesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Note}">
                            <StackPanel Margin="17,12,14,12" Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add/Edit Tags" Click="CtxTags_Click"/>
                                        <MenuItem Header="Add/Edit Snippet" Click="CtxSnippet_Click"/>
                                        <MenuItem Header="Delete Note" Click="CtxDelete_Click"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding DisplayTitle}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Snippet}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ModifiedDisplay}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" Margin="0,7,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer: version + theme toggle + check for updates -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="16,7,10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VersionText" Grid.Column="0" Text="v1.1.3"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11.5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ThemeToggleButton" Style="{StaticResource IconButton}"
                                    Content="&#xE706;" ToolTip="Toggle light / dark mode"
                                    Click="ThemeToggleButton_Click"/>
                            <Button x:Name="UpdateButton" Style="{StaticResource LinkButton}"
                                    Content="Check for updates" Margin="4,0,4,0"
                                    Click="UpdateButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ============================================================ -->
        <!-- RIGHT EDITOR PANE                                             -->
        <!-- ============================================================ -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBgBrush}">
            <Grid x:Name="EditorRoot" Margin="26,18,26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- title + actions -->
                    <RowDefinition Height="Auto"/>  <!-- tags -->
                    <RowDefinition Height="Auto"/>  <!-- toolbar -->
                    <RowDefinition Height="*"/>     <!-- editor -->
                </Grid.RowDefinitions>

                <!-- Title + delete -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" Grid.Column="0"
                             Style="{StaticResource PlaceholderTextBox}"
                             Tag="Untitled Note"
                             FontSize="24" FontWeight="Bold"
                             TextChanged="TitleBox_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SnippetButton" Style="{StaticResource IconButton}"
                                Content="&#xE70B;" ToolTip="Add/edit snippet"
                                Click="SnippetButton_Click"/>
                        <Button x:Name="DeleteButton" Style="{StaticResource IconButton}"
                                Content="&#xE74D;" ToolTip="Delete note"
                                Click="DeleteButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Tags row -->
                <Border Grid.Row="1" Margin="0,10,0,0" Padding="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="TagsList" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource FieldBrush}"
                                            CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2756;" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                    FontSize="9" Margin="6,0,0,0"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="Remove tag"
                                                    Click="RemoveTag_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="TagInput" Width="200" VerticalAlignment="Center"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="Link tags"
                                 FontSize="12.5"
                                 KeyDown="TagInput_KeyDown"/>
                    </StackPanel>
                </Border>

                <!-- Formatting toolbar -->
                <Border Grid.Row="2" Background="{DynamicResource FieldBrush}"
                        CornerRadius="10" Padding="8,5" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">

                        <!-- Formatting dropdown (shows current format's icon) -->
                        <Button x:Name="FormatButton" Style="{StaticResource ToolButton}"
                                ToolTip="Paragraph format" Click="FormatButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="FormatIcon" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>

                        <!-- Alignment dropdown -->
                        <Button x:Name="AlignButton" Style="{StaticResource ToolButton}"
                                ToolTip="Text alignment" Click="AlignButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AlignIcon" Text="&#xE8E4;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Indent / outdent (vector icons) -->
                        <Button x:Name="IndentBtn" Style="{StaticResource ToolButton}"
                                ToolTip="Increase indent" Click="Indent_Click">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M0,1 L16,1 L16,3 L0,3 Z M0,13 L16,13 L16,15 L0,15 Z M7,5 L16,5 L16,6.8 L7,6.8 Z M7,9.2 L16,9.2 L16,11 L7,11 Z M0,4.3 L5,8 L0,11.7 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="OutdentBtn" Style="{StaticResource ToolButton}"
                                ToolTip="Decrease indent" Click="Outdent_Click">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M0,1 L16,1 L16,3 L0,3 Z M0,13 L16,13 L16,15 L0,15 Z M7,5 L16,5 L16,6.8 L7,6.8 Z M7,9.2 L16,9.2 L16,11 L7,11 Z M5,4.3 L0,8 L5,11.7 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                        </Button>

                        <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>

                        <ToggleButton x:Name="BoldBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Bold (Ctrl+B)" Click="Bold_Click">
                            <TextBlock Text="B" FontWeight="Bold"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Italic (Ctrl+I)" Click="Italic_Click">
                            <TextBlock Text="I" FontStyle="Italic"/>
                        </ToggleButton>
                        <ToggleButton x:Name="UnderlineBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Underline (Ctrl+U)" Click="Underline_Click">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </ToggleButton>
                        <ToggleButton x:Name="StrikeBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Strikethrough" Click="Strike_Click">
                            <TextBlock Text="S" TextDecorations="Strikethrough"/>
                        </ToggleButton>

                        <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>

                        <!-- Decrease / increase font size by 1 -->
                        <Button x:Name="SizeDownBtn" Style="{StaticResource ToolButton}"
                                ToolTip="Decrease text size" Click="SizeDown_Click">
                            <TextBlock Text="&#x2013;" FontSize="16"/>
                        </Button>
                        <Button x:Name="SizeUpBtn" Style="{StaticResource ToolButton}"
                                ToolTip="Increase text size" Click="SizeUp_Click">
                            <TextBlock Text="+" FontSize="16"/>
                        </Button>

                        <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>

                        <!-- Text color (opens a popup with swatches + reset) -->
                        <Button x:Name="ColorBtn" Style="{StaticResource ToolButton}"
                                ToolTip="Text color" Click="ColorButton_Click">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Rich text editor -->
                <RichTextBox x:Name="Editor" Grid.Row="3"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             FontFamily="Segoe UI" FontSize="14"
                             Padding="0,4,0,0"
                             AcceptsTab="True"
                             SpellCheck.IsEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             SelectionChanged="Editor_SelectionChanged"
                             TextChanged="Editor_TextChanged"
                             PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0,0,0,10"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Grid>
        </Border>

        <!-- ================= Formatting popup ================= -->
        <Popup x:Name="FormatPopup" PlacementTarget="{Binding ElementName=FormatButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="4">
            <Border Background="{DynamicResource MenuBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="5" Width="210">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <StackPanel x:Name="FormatMenuPanel">
                    <Button Style="{StaticResource MenuRowButton}" Tag="Normal" Click="Format_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Normal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRowButton}" Tag="H1" Click="Format_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="H1" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Heading 1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRowButton}" Tag="H2" Click="Format_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="H2" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Heading 2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRowButton}" Tag="H3" Click="Format_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="H3" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Heading 3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Margin="6,5" Background="{DynamicResource BorderBrush}"/>
                    <Button Style="{StaticResource MenuRowButton}" Tag="Bulleted" Click="Format_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Bulleted List" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRowButton}" Tag="Numbered" Click="Format_Selected">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl x:Name="NumberedMenuIcon" Width="26" VerticalAlignment="Center"
                                            HorizontalContentAlignment="Left"/>
                            <TextBlock Text="Numbered List" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRowButton}" Tag="Check" Click="Format_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Check List" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= Alignment popup ================= -->
        <Popup x:Name="AlignPopup" PlacementTarget="{Binding ElementName=AlignButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" VerticalOffset="4">
            <Border Background="{DynamicResource MenuBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="5" Width="170">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <StackPanel x:Name="AlignMenuPanel">
                    <Button Style="{StaticResource MenuRowButton}" Tag="Left" Click="Align_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Left align" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRowButton}" Tag="Center" Click="Align_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="&#xE8E3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Center align" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRowButton}" Tag="Right" Click="Align_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="&#xE8E2;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Right align" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRowButton}" Tag="Justify" Click="Align_Selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Justify" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= Color popup ================= -->
        <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorBtn}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" VerticalOffset="4">
            <Border Background="{DynamicResource MenuBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8" Width="230">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <UniformGrid Columns="6">
                        <!-- Row 1: greyscale, black -> white -->
                        <Button Style="{StaticResource SwatchButton}" Tag="#000000" Background="#000000" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#333333" Background="#333333" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#666666" Background="#666666" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#999999" Background="#999999" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#CCCCCC" Background="#CCCCCC" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#FFFFFF" Background="#FFFFFF" Click="ColorSwatch_Click"/>
                        <!-- Row 2: warm colors -->
                        <Button Style="{StaticResource SwatchButton}" Tag="#E5484D" Background="#E5484D" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#EC7B2B" Background="#EC7B2B" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#F5A524" Background="#F5A524" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#EFC000" Background="#EFC000" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#A0C93B" Background="#A0C93B" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#46A758" Background="#46A758" Click="ColorSwatch_Click"/>
                        <!-- Row 3: cool colors -->
                        <Button Style="{StaticResource SwatchButton}" Tag="#12A594" Background="#12A594" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#0EA5C4" Background="#0EA5C4" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#2F7FE0" Background="#2F7FE0" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#4256D0" Background="#4256D0" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#8E4EC6" Background="#8E4EC6" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Tag="#D6489B" Background="#D6489B" Click="ColorSwatch_Click"/>
                    </UniformGrid>
                    <Border Height="1" Margin="2,7" Background="{DynamicResource BorderBrush}"/>
                    <Button Style="{StaticResource MenuRowButton}" Click="MoreColors_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="&#xE790;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="More colors…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRowButton}" Click="ClearColor_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="&#xE894;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Reset to default" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= Tags popup ================= -->
        <Popup x:Name="TagsPopup" PlacementTarget="{Binding ElementName=EditorRoot}"
               Placement="Center" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource MenuBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16" Width="360">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Tags" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="TagsPopupList" MinHeight="26">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource FieldBrush}"
                                        CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2756;" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                FontSize="9" Margin="6,0,0,0"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" ToolTip="Remove tag"
                                                Click="RemoveTag_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource FieldBrush}" CornerRadius="8"
                            Padding="10,0" Margin="0,4,0,0" Height="36">
                        <TextBox x:Name="TagsPopupInput" VerticalAlignment="Center"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="Add a tag and press Enter"
                                 KeyDown="TagsPopupInput_KeyDown"/>
                    </Border>
                    <Button Content="Done" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Style="{StaticResource LinkButton}" FontSize="13"
                            Click="CloseTagsPopup_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= Snippet popup ================= -->
        <Popup x:Name="SnippetPopup" PlacementTarget="{Binding ElementName=EditorRoot}"
               Placement="Center" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource MenuBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16" Width="380">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Snippet" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Shown in the note list instead of the note text."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12" Margin="0,3,0,10" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource FieldBrush}" CornerRadius="8" Padding="10,8">
                        <TextBox x:Name="SnippetInput"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="Type a short snippet..."
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="90" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Clear" Style="{StaticResource LinkButton}" FontSize="13"
                                Margin="0,0,16,0" Click="SnippetClear_Click"/>
                        <Button Content="Save" Style="{StaticResource LinkButton}" FontSize="13"
                                Click="SnippetSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
