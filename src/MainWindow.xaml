<Window x:Class="SimpleNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleNotes"
        Title="Simple Notes"
        Icon="app.ico"
        Height="640" Width="1120"
        MinHeight="420" MinWidth="760"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="260"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT SIDEBAR                                                  -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: "Notes" + sort + add -->
                <Grid Grid.Row="0" Margin="18,16,14,6">
                    <TextBlock Text="Notes"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SortButton" Style="{StaticResource IconButton}"
                                Content="&#xE8CB;" ToolTip="Sort by date modified"
                                Click="SortButton_Click"/>
                        <Button x:Name="AddButton" Style="{StaticResource AccentButton}"
                                Content="&#xE710;" Margin="6,0,0,0" ToolTip="New note"
                                Click="AddButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Search box -->
                <Border Grid.Row="1" Margin="14,8,14,10"
                        Background="{StaticResource FieldBrush}"
                        CornerRadius="10" Padding="12,0">
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="Search..."
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Notes list -->
                <ListBox x:Name="NotesList" Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NoteItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="NotesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Note}">
                            <Grid Margin="15,12,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE8A1;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Top" Margin="0,2,11,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Snippet}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12.5" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ModifiedDisplay}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Margin="0,7,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer: version + check for updates -->
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="16,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VersionText" Grid.Column="0" Text="v1.0.0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5" VerticalAlignment="Center"/>
                        <Button x:Name="UpdateButton" Grid.Column="1"
                                Style="{StaticResource LinkButton}"
                                Content="Check for updates"
                                Click="UpdateButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ============================================================ -->
        <!-- RIGHT EDITOR PANE                                             -->
        <!-- ============================================================ -->
        <Border Grid.Column="2" Background="{StaticResource PanelBgBrush}">
            <Grid x:Name="EditorRoot" Margin="26,18,26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- title + actions -->
                    <RowDefinition Height="Auto"/>  <!-- tags -->
                    <RowDefinition Height="Auto"/>  <!-- toolbar -->
                    <RowDefinition Height="*"/>     <!-- editor -->
                </Grid.RowDefinitions>

                <!-- Title + top-right action icons -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" Grid.Column="0"
                             Style="{StaticResource PlaceholderTextBox}"
                             Tag="Untitled Note"
                             FontSize="24" FontWeight="Bold"
                             TextChanged="TitleBox_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE71B;" ToolTip="Link"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A1;" ToolTip="Outline"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE840;" ToolTip="Pin"/>
                        <Button x:Name="DeleteButton" Style="{StaticResource IconButton}"
                                Content="&#xE712;" ToolTip="Delete note"
                                Click="DeleteButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Tags row -->
                <Border Grid.Row="1" Margin="0,10,0,0" Padding="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="TagsList" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource FieldBrush}"
                                            CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2756;" FontSize="10"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                    FontSize="9" Margin="6,0,0,0"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="Remove tag"
                                                    Click="RemoveTag_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="TagInput" Width="200" VerticalAlignment="Center"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="Link tags, notes, files..."
                                 FontSize="12.5"
                                 KeyDown="TagInput_KeyDown"/>
                    </StackPanel>
                </Border>

                <!-- Formatting toolbar -->
                <Border Grid.Row="2" Background="{StaticResource FieldBrush}"
                        CornerRadius="10" Padding="8,5" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="BoldBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Bold (Ctrl+B)" Click="Bold_Click">
                            <TextBlock Text="B" FontWeight="Bold"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Italic (Ctrl+I)" Click="Italic_Click">
                            <TextBlock Text="I" FontStyle="Italic"/>
                        </ToggleButton>
                        <ToggleButton x:Name="UnderlineBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Underline (Ctrl+U)" Click="Underline_Click">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </ToggleButton>
                        <ToggleButton x:Name="StrikeBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Strikethrough" Click="Strike_Click">
                            <TextBlock Text="S" TextDecorations="Strikethrough"/>
                        </ToggleButton>

                        <Border Width="1" Margin="6,4" Background="{StaticResource BorderBrush}"/>

                        <ToggleButton x:Name="BulletBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Bulleted list" Click="Bullets_Click">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </ToggleButton>
                        <ToggleButton x:Name="NumberBtn" Style="{StaticResource FormatToggle}"
                                      ToolTip="Numbered list" Click="Numbering_Click">
                            <TextBlock Text="&#xF12B;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </ToggleButton>

                        <Border Width="1" Margin="6,4" Background="{StaticResource BorderBrush}"/>

                        <ComboBox x:Name="FontFamilyCombo" Width="140" Height="28"
                                  VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Font"
                                  SelectionChanged="FontFamilyCombo_SelectionChanged">
                            <ComboBoxItem Content="Segoe UI" IsSelected="True"/>
                            <ComboBoxItem Content="Arial"/>
                            <ComboBoxItem Content="Calibri"/>
                            <ComboBoxItem Content="Cambria"/>
                            <ComboBoxItem Content="Consolas"/>
                            <ComboBoxItem Content="Georgia"/>
                            <ComboBoxItem Content="Times New Roman"/>
                            <ComboBoxItem Content="Verdana"/>
                        </ComboBox>

                        <ComboBox x:Name="FontSizeCombo" Width="64" Height="28" IsEditable="True"
                                  VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Font size"
                                  SelectionChanged="FontSizeCombo_SelectionChanged"
                                  KeyDown="FontSizeCombo_KeyDown">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="11"/>
                            <ComboBoxItem Content="12"/>
                            <ComboBoxItem Content="14" IsSelected="True"/>
                            <ComboBoxItem Content="16"/>
                            <ComboBoxItem Content="18"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="24"/>
                            <ComboBoxItem Content="28"/>
                            <ComboBoxItem Content="32"/>
                            <ComboBoxItem Content="48"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Rich text editor -->
                <RichTextBox x:Name="Editor" Grid.Row="3"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             FontFamily="Segoe UI" FontSize="14"
                             Padding="0,4,0,0"
                             AcceptsTab="True"
                             SpellCheck.IsEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             SelectionChanged="Editor_SelectionChanged"
                             TextChanged="Editor_TextChanged">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0,0,0,10"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Grid>
        </Border>
    </Grid>
</Window>
